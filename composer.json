{
    "name": "laurentmeuwly/formbuilder",
    "description": "Database-driven dynamic forms for Laravel: form definitions, conditional branching, validation rules and answer storage.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "forms",
        "form-builder",
        "dynamic-forms",
        "branching",
        "filament"
    ],
    "authors": [
        {
            "name": "Laurent Meuwly",
            "email": "laurent@lmeuwly.ch",
            "homepage": "https://axonium.ch",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0"
    },
    "require-dev": {
        "filament/forms": "^3.3|^4.0|^5.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "suggest": {
        "filament/forms": "Required only if you use the optional FilamentFormRenderer (Filament 3, 4 or 5)."
    },
    "autoload": {
        "psr-4": {
            "LaurentMeuwly\\FormBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaurentMeuwly\\FormBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaurentMeuwly\\FormBuilder\\FormBuilderServiceProvider"
            ],
            "aliases": {
                "FormBuilder": "LaurentMeuwly\\FormBuilder\\Facades\\FormBuilder"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test"
    }
}
